# Site (Vercel): URL of the shared worker. Leave empty and every tab scans on its own.
NEXT_PUBLIC_WORKER_URL=

# Optional: your own Solana RPC (Helius free key etc.), used before the public ones
NEXT_PUBLIC_RPC_URL=

# Worker only
PORT=8787
DATA_DIR=./data
RPC_URL=
# Comma separated words the shared scanner always watches, same for everyone
WATCHLIST=
# Telegram calls are on hold. Set NEXT_PUBLIC_CALLS_ENABLED=1 to turn them on, then list public channel usernames (comma separated, without @)
NEXT_PUBLIC_CALLS_ENABLED=
CALL_CHANNELS=
# Smart wallets you know yourself (comma separated). Learned wallets are added automatically.
SMART_WALLETS=
# Worker: how many top smart wallets to poll each minute, and learning from a sample of all launches (0 = off)
SMART_WATCH=40
LEARN_SAMPLE=1
# Re-read pump.fun launches the PumpPortal stream dropped, from the chain (worker, ~0.5 RPC reads a second at busy times)
BACKFILL_CREATES=1
# Scanner mode: narrative matching is off by default (on-chain scanner). Set to 1 for the old narrative scanner.
NEXT_PUBLIC_NARRATIVE=
# Call gate (lib/score2.ts): optional extra score floor (0 = off), calls per 24h and per hour
CALL_MIN_SCORE=0
NEXT_PUBLIC_CALL_MIN_SCORE=0
CALL_MAX_PER_DAY=50
CALL_MAX_PER_HOUR=3
# Runner proof: multiple since launch and minimum market cap (USD)
RUNNER_X=5
RUNNER_MIN_USD=30000
# Anti-rug: no call before this many minutes after launch (under 2 min old: 47% ended under 0.2x within 45 min),
# and optionally make a graduated token hold this many minutes on its pool first (0 = off).
# Instant graduations (launch to migration under 3 min) always need the wallet read (bundle check) first.
CALL_MIN_AGE_MIN=3
CALL_GRAD_HOLD_MIN=0
# Graduating proof (bonding curve percent). Off by default (0): it did not hold up on unseen data
GRADUATING_PCT=0
# Risky tier (fresh launch rule, separate list and track record): on by default
EARLY_CALLS=1
EARLY_MAX_PER_HOUR=15
EARLY_MAX_PER_DAY=300
EARLY_MAX_AGE_MIN=3
EARLY_MIN_USD=6000
EARLY_MAX_USD=16000
EARLY_MAX_CURVE=65
EARLY_MAX_DEV_SOL=1
# Ultra risky tier (first 3 min, $6K+, 2x+ since launch, curve 80% or less, dev buy under 1 SOL, ~270 a day): on by default
ULTRA_CALLS=1
ULTRA_MAX_PER_HOUR=40
ULTRA_MAX_PER_DAY=600
ULTRA_MIN_USD=6000
ULTRA_MAX_CURVE=80

# Trader network (worker). Named KOL wallets come from kolscan.io's public list; add your own as name:wallet,...
KOL_WALLETS=
# Smallest KOL/smart buy (SOL) that counts toward a call; smaller ones are shown in the feed only
KOL_MIN_BUY_SOL=0.2
# How many KOLs to watch (free RPC polling: 120 by default, 10 wallets every 15 s; with PumpPortal: 300)
KOL_WATCH=
KOL_POLL_PER_TICK=10
# PumpPortal API key (worker .env only, never on Vercel or in NEXT_PUBLIC_*). Streams KOL and smart wallet
# trades live. Billed 0.01 SOL per 10,000 messages from the wallet linked to the key (fund it with 0.02+ SOL).
# The key can also trade with that wallet, so keep only a small balance there.
PUMPPORTAL_API_KEY=
# Also stream every trade of radar tokens with the key (costly, off by default)
PUMPPORTAL_TOKEN_TRADES=
